# Raw GTFS feed downloads. These are NOT needed to run or build the site — the derived
# stop set in src/shared/data/rail/ is committed and compiled into the bundle. You only
# need these to regenerate it with `node scripts/build-rail-stops.mjs`.
#
# Do NOT ignore src/shared/data/rail/*.json — the build fails without them.
data/gtfs/

